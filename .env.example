# TaskGenie configuration. Copy to .env and adjust.
#
# NOTE — API-key / base-URL fallback:
#   If TASKGENIE_API_KEY is empty (or "lm-studio"), TaskGenie will
#   automatically fall back to OPENAI_API_KEY.  Likewise,
#   TASKGENIE_BASE_URL falls back to OPENAI_BASE_URL when it is unset
#   or still the default localhost value.  This means you can point
#   TaskGenie at the OpenAI API (or any compatible provider) just by
#   having the standard OPENAI_* vars in your environment — no
#   TaskGenie-specific overrides needed.

# ── Endpoint ────────────────────────────────────────────────────────

# OpenAI-compatible endpoint (LM Studio, vLLM, llama.cpp server, etc.).
# Falls back to OPENAI_BASE_URL if this is unset or the default value.
TASKGENIE_BASE_URL=http://localhost:1234/v1

# API key for the endpoint above.
# Falls back to OPENAI_API_KEY if empty or "lm-studio".
TASKGENIE_API_KEY=

# ── Model selection ─────────────────────────────────────────────────

# Default model for all roles. Leave empty to auto-detect the first
# model the endpoint reports.
TASKGENIE_MODEL=

# Per-role model overrides (optional). When set, the given role uses
# this model instead of TASKGENIE_MODEL.  Useful for running a stronger
# model as CEO/manager and a cheaper/faster one for workers.
# TASKGENIE_CEO_MODEL=
# TASKGENIE_MANAGER_MODEL=
# TASKGENIE_WORKER_MODEL=

# Per the model lab's recommendation for your chosen model (0.0–2.0).
TASKGENIE_TEMPERATURE=0.1

# ── Execution limits ───────────────────────────────────────────────

# Maximum depth of the agent hierarchy (CEO -> Manager -> Worker …).
TASKGENIE_MAX_DEPTH=8

# Maximum turns (LLM round-trips) any single agent may take.
TASKGENIE_MAX_TURNS=1000

# Concurrent LLM calls cap. Prevents a manager hiring many workers
# from hammering the endpoint all at once.
TASKGENIE_MAX_CONCURRENT_LLM=2

# Sandboxed code execution: max wall-clock seconds per exec_code /
# exec_workspace call.
TASKGENIE_EXEC_TIMEOUT=60

# MCP tool-call timeout (per call). Protects against a hung MCP server
# blocking an agent forever.
TASKGENIE_MCP_CALL_TIMEOUT=60

# ── Token budget & cost ────────────────────────────────────────────

# Hard cap on total session tokens (prompt + completion across all
# agents). 0 = unlimited.
TASKGENIE_MAX_SESSION_TOKENS=0

# Cost per million tokens (USD). Used for the cost estimate printed at
# session end. 0 = no cost tracking.
TASKGENIE_TOKEN_COST_PER_MILLION=0.0

# ── Context-window management ──────────────────────────────────────

# Total context-window size (tokens) of the model. Default suits
# Claude 3.5+ / many local models; smaller models should lower this.
TASKGENIE_CTX_WINDOW=128000

# Fraction of ctx_window at which an Archivist summary is triggered
# to compact the message history (0.0–1.0).
TASKGENIE_COMPACT_AT_PCT=0.8

# Number of most-recent messages to keep verbatim when compacting.
TASKGENIE_COMPACT_KEEP_RECENT=3

# Tool replies larger than this (bytes) are written to a scratch file
# and replaced inline with a one-line pointer.
TASKGENIE_DUMP_OVER_BYTES=131072

# ── Output & paths ─────────────────────────────────────────────────

# Where session state, scratch files, and event logs live.
TASKGENIE_DATA_DIR=.taskgenie

# Where user-facing project deliverables (the workspace) get written.
# A subdirectory per project is created here (slug derived from the
# task, numeric suffix on collision).
TASKGENIE_PROJECTS_DIR=TaskGenie

# Path to MCP server config (Claude Desktop / Cursor / LM Studio format).
TASKGENIE_MCP_CONFIG=./mcp.json

# ── Subprocess environment ─────────────────────────────────────────

# Extra env vars to pass through to exec_code / exec_workspace
# subprocesses (comma-separated). By default every non-allowlisted
# var is scrubbed so secrets don't leak.  Use this to expose API keys
# a worker's snippet legitimately needs.
# TASKGENIE_EXEC_ENV_PASSTHROUGH=BRAVE_API_KEY,OPENAI_API_KEY

# ── Logging & UI ───────────────────────────────────────────────────

# Python log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
TASKGENIE_LOG_LEVEL=WARNING

# Run without the interactive TUI (e.g. in CI or piped scripts).
# Accepts: true/false, 1/0, yes/no.
TASKGENIE_HEADLESS=false
