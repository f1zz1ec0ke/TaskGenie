# TaskGenie configuration. Copy to .env and adjust.

# OpenAI-compatible endpoint (LM Studio, vLLM, llama.cpp server, etc.).
TASKGENIE_BASE_URL=http://localhost:1234/v1
TASKGENIE_API_KEY=lm-studio

# Leave empty to auto-detect the first model the endpoint reports.
TASKGENIE_MODEL=

# Per the model lab's recommendation for your chosen model.
TASKGENIE_TEMPERATURE=0.1

# Hierarchy and execution limits.
TASKGENIE_MAX_DEPTH=8
TASKGENIE_MAX_TURNS=1000

# Concurrent LLM calls cap (prevents a manager hiring 10 workers from
# hammering the endpoint).
TASKGENIE_MAX_CONCURRENT_LLM=2

# Sandboxed code execution: max wall-clock seconds per exec_code call.
TASKGENIE_EXEC_TIMEOUT=60

# MCP tool-call timeout (per call). Protects against a hung MCP server
# blocking an agent forever.
TASKGENIE_MCP_CALL_TIMEOUT=60

# Context-window management. ctx_window is the model's total budget;
# compact_at_pct triggers an Archivist summary when the message history
# approaches that fraction. compact_keep_recent preserves the last N
# messages verbatim. dump_over_bytes routes tool replies larger than
# this to a scratch file (replaced inline with a one-line pointer).
TASKGENIE_CTX_WINDOW=128000
TASKGENIE_COMPACT_AT_PCT=0.6
TASKGENIE_COMPACT_KEEP_RECENT=3
TASKGENIE_DUMP_OVER_BYTES=16384

# Where session state, scratch files, and event logs live.
TASKGENIE_DATA_DIR=.taskgenie

# Path to MCP server config (Claude Desktop / Cursor / LM Studio format).
TASKGENIE_MCP_CONFIG=./mcp.json
